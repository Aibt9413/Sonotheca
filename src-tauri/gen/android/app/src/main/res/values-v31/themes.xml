<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ 系统 Splash：深海蓝底 + 居中水母 Logo -->
    <style name="Theme.sonotheca" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/sonotheca_splash</item>
        <item name="android:statusBarColor">@color/sonotheca_splash</item>
        <item name="android:navigationBarColor">@color/sonotheca_splash</item>
        <item name="android:windowSplashScreenBackground">@color/sonotheca_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/sonotheca_splash</item>
    </style>
</resources>
